DECLARE PLUGIN "rocqet.plugin"
(* https://github.com/coq/coq/blob/master/dev/doc/parsing.md *)

{
  [@@@warning "-27"]
  (* Diable warnings about unused names in the generared ml file *)
  open Stdarg
  open Ltac_plugin.Tacarg
  open Pvernac.Vernac_
  open Pcoq.Constr
  open Pcoq.Prim
  open Ltac_plugin  
  open Types

  let wit_mutind_defs : (Types.VernacInductive.t, Util.Empty.t, Util.Empty.t) Genarg.genarg_type =
    Genarg.create_arg "coq_ind_sig"

  let wit_list1ident : (Names.Id.t list, Util.Empty.t, Util.Empty.t) Genarg.genarg_type =
    Genarg.create_arg "list1ident_ty"

  let wit_reference_ip : (Libnames.qualid, Util.Empty.t, Util.Empty.t) Genarg.genarg_type =
    Genarg.create_arg "reference_ip"

  let wit_llconstr_ip : (Constrexpr.constr_expr, Genintern.glob_constr_and_expr, EConstr.t) Genarg.genarg_type =
    Genarg.create_arg "llconstr_ip"

  let mutind_defs : Types.VernacInductive.t Pcoq.Entry.t =
    Pcoq.create_generic_entry2 "mutind_defs" (Genarg.rawwit wit_mutind_defs)

  let list1ident : Names.Id.t list Pcoq.Entry.t =
    Pcoq.create_generic_entry2 "list1ident" (Genarg.rawwit wit_list1ident)

  let reference_ip : Libnames.qualid Pcoq.Entry.t =
    Pcoq.create_generic_entry2 "reference_ip" (Genarg.rawwit wit_reference_ip)

  let llconstr_ip : Constrexpr.constr_expr Pcoq.Entry.t =
    Pcoq.create_generic_entry2 "llconstr_ip" (Genarg.rawwit wit_llconstr_ip)

  let test_second_token_about =
    let open Pcoq.Lookahead in
    to_entry "test_second_token_about" begin
      lk_ident >> lk_kw "about"
    end

 let _in_proof_mode _ = Vernacextend.(VtStartProof (Doesn'tGuaranteeOpacity,[]))
}

GRAMMAR EXTEND Gram
GLOBAL: mutind_defs llconstr_ip gallina_ext list1ident reference_ip;
  list1ident :
    [[ listid = LIST1 ident -> { listid }]];  
  mutind_defs :
    [[ indl = LIST1 inductive_or_record_definition SEP "with" -> { indl } ]];
  llconstr_ip :
    [[ c = lconstr -> { (* attach_self_prefix *) c } ]];
  reference_ip :
    [[ r = reference -> { (* attach_self_prefix_qualid*) r } ]];
  gallina_ext : TOP
    [[  ]];
END

ARGUMENT EXTEND induction_decl
| [ ident(name) "about" reference_ip(inductive) "motive" llconstr_ip(motive) ] ->
  { Frec_arg.{ name; inductive; motive }  }
END

ARGUMENT EXTEND induction_decls
| [ test_second_token_about ne_induction_decl_list_sep(ind_decls, "with") ] ->
  { ind_decls }
END

ARGUMENT EXTEND ne_entry_list_comma
| [ preident_list_sep(arguments, ",") ] -> { List.map Names.Id.of_string arguments }
END

ARGUMENT EXTEND argument_type
| [ "(" ident(i) ":" llconstr_ip(t)  ")" ne_constr_list(l) ] -> { (i, t) }
END

VERNAC ARGUMENT EXTEND argument
  | [ llconstr_ip(t) ] -> { (Names.Id.of_string "_", t) }
  | [ "(" ident(i) ":" llconstr_ip(t) ")" ] -> { (i, t) }
END

VERNAC ARGUMENT EXTEND argument_flist
  | [ argument(arg) ] -> { [arg] }
  | [ argument(arg) "->" argument_flist(rest) ] -> { arg :: rest }
END

VERNAC COMMAND EXTEND FamilyPolyExtension CLASSIFIED AS SIDEFF
| [ "Family" ident(derived) "extends"
    reference_list_sep(arguments, ",") ] -> { Entry.family_extends_list ~derived ~bases:arguments }

| [ "Family" ident(name) ] -> { Entry.family name }

| [ "Final" "Family" ident(name) ":=" reference_ip(definition) ] -> { Entry.final_family ~name ~value:definition }

| [ "FInductive" mutind_defs(inductive_definition) ] -> { Entry.finductive inductive_definition }

(* | [ "Trait" ident(name) "extends" ident(base) ] -> { Entry.open_trait_with_base ~name ~base }*)

| [ "Trait" ident(name) "extends"
    ne_ident_list_sep(arguments, ",") ] -> { Entry.open_trait_with_base_list ~name ~bases:arguments }

| [ "Trait" ident(name) ] -> { Entry.open_trait ~name }

| [ "FEnd" ident(scope_name) ] -> { Entry.fend scope_name }

| [ "FEnd" ne_ident_list_sep(scope_names, "with") ] -> { Entry.fend_with scope_names }

| [ "FDefinition" ident(name) ":" llconstr_ip(body_type) ":=" llconstr_ip(body_expr)  ] ->
   { Entry.definition ~name ~body_type body_expr }

| [ "FOpaque" "Definition" ident(name) ":" llconstr_ip(body_type) ":=" llconstr_ip(body_expr)  ] ->
   { Entry.opaque_definition ~name ~body_type ~body_expr }

| [ "FOverride" "Definition" ident(name) ":=" llconstr_ip(expr)  ] ->
   { Entry.foverride ~name ~expr }

| [ "FDefinition" ident(name) ":=" llconstr_ip(body_expr)  ] ->
   { Entry.definition ~name body_expr }

(*| [ "FRecursion" ident(name) ":" argument_flist(args) ] -> 
   { Entry.frecursion_elegant name args } *)

| [ "FRecursion" ne_ident_list_sep(names, "with") ] -> { Entry.frecursion_extension ~names }

| [ "FRecursion" induction_decls(ind_decls) "by" ident(reckind) ] -> 
   { Entry.frecursion ind_decls (RecKind.of_name reckind) }

| [ "Case" "_" ":=" constr(handler) ] -> 
   { Entry.add_wildcard_handler ~handler }

| [ "Case" ident(name) list1ident(arguments) ":=" constr(handler) ] -> 
   {  Entry.frecursion_handler ~name ~arguments:(Some arguments) ~handler }

| [ "Case" ident(name) ":=" constr(handler) ] -> 
   {  Entry.frecursion_handler ~name ~arguments:None ~handler }

| [ "FInduction" ne_ident_list_sep(names, "with") ] ->
   { Entry.finduction_extension ~names }

| [ "FInduction" induction_decls(ind_decls) ] ->
   {  Entry.finduction ind_decls }

| [ "FLemma" ident(name) ":" llconstr_ip(t) ] -> { Entry.flemma name t }

| [ "Inherit" ident(name) ] -> { Entry.inherit_name ~name }

| [ "FOverride" "Lemma" ident(name)  ] ->
   { Entry.foverride_lemma name }

| [ "CloseFLemma" ] -> { Entry.close_flemma () }

| [ "MetaData" ident(i) ] -> { Entry.metadata i }

| [ "FDisplay" "PluginScope" ] -> { Entry.display_plugin_scope () }

| [ "Closing" "Fact" ident(name) ":" llconstr_ip(ty) "by" "{" tactic(script) "}" ] -> 
  { Entry.closing_fact ~name ~ty ~script ~plain:false }

| [ "Closing" "Fact" ident(name) ":" llconstr_ip(ty) "by" "plain" "{" tactic(script) "}" ] -> 
  { Entry.closing_fact ~name ~ty ~script ~plain:true }

(*| [ "Prect" reference_ip(inductive_path) ] -> { 
    Partial_recursor.add ~inductive_path
  }*)

END

VERNAC COMMAND EXTEND FamilyPolyProof CLASSIFIED BY { _in_proof_mode } STATE open_proof
| ["FProof"] -> { Entry.fproof () }
| ["FProofLemma"] -> { Entry.fproof_lemma () }
END

TACTIC EXTEND fsimpl
| [ "fsimpl" "in" ident(h) ] -> { Ftactics.fsimpl_in h }
| [ "fsimpl" "in" "*" ] -> { Ftactics.fsimpl_star () }
| [ "fsimpl" ] -> { Ftactics.fsimpl () }
END

TACTIC EXTEND fconstructor
| [ "fconstructor" ] -> { Ftactics.fconstructor () }
END
