DECLARE PLUGIN "nfpop.plugin"

{
  open Stdarg  
  (* open Pvernac.Vernac_ *)
  (* open Ltac_plugin *)
  let wit_mutind_defs : (Ftypes.VernacInductive.t, Util.Empty.t, Util.Empty.t) Genarg.genarg_type =
        Genarg.create_arg "coq_ind_sig"
}


VERNAC COMMAND EXTEND FamilyPolyExtension CLASSIFIED AS SIDEFF

| [ "Family" ident(derived) "extends" ident(base)] ->  { Fentry.family_extends ~derived ~base }
| [ "Family" ident(name) ] -> { Fentry.family name }
| [ "FInductive" mutind_defs(inductive_definition) ] -> { Fentry.finductive inductive_definition }
| [ "FEnd" ident(scope_name) ] -> { Fentry.fend scope_name }

END


